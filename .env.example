# Sao chép thành .env (KHÔNG commit). Phần lớn giá trị được script tự sinh:
#   python -m soc.elastic.elastic_ctl setup   → ELASTIC_PASSWORD, KIBANA_ENC_KEY_*
#   python -m soc.elastic.indices             → SOC_APP_ES_PASSWORD (user quyền tối thiểu)
#   python -m soc.api.users demo              → mật khẩu tài khoản demo
#   python -m soc.api.main (lần đầu)          → SOC_SESSION_SECRET
SOC_DATA_DIR=F:/soc-ueba-data
ELASTIC_PASSWORD=
SOC_APP_ES_PASSWORD=
# Đặt 1 khi chạy sau reverse proxy HTTPS (cookie phiên chỉ gửi qua HTTPS)
SESSION_HTTPS_ONLY=0
